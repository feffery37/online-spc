{
  "Spc": {
    "Provider": "Sqlite",
    "LateArrivalToleranceSeconds": 0,
    "Phase": "M0/M1/M2/M3/M4/M5",
    "MesGateway": {
      "Mode": "Simulated",
      "HoldUrl": "http://localhost:5090/api/mes/hold"
    },
    "Reports": {
      "Enabled": true,
      "IntervalMinutes": 5
    }
  },
  "ConnectionStrings": {
    "Spc": "Data Source=spc.db"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "SqlSugar": "Warning"
    }
  },
  "AllowedHosts": "*"
}
